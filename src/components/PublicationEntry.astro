---
import type { Publication } from "@data/types";

type Props = {
  publication: Publication;
};

const { publication } = Astro.props;
---

<article class="publication-entry">
  <div class="publication-entry__meta">
    <span class="badge">{publication.typeLabel}</span>
    <span>{publication.year}</span>
  </div>
  <h2>{publication.title}</h2>
  <p class="publication-entry__authors">
    {
      publication.authors.map((author, index) => (
        <>
          {index > 0 && <span>, </span>}
          <span class:list={[author.highlight && "author-highlight"]}>{author.name}</span>
        </>
      ))
    }
  </p>
  <p class="publication-entry__venue">
    <strong>{publication.venue}</strong>
    {publication.details && <> · {publication.details}</>}
  </p>
  {publication.summary && <p>{publication.summary}</p>}
  {publication.associatedWith && (
    <p class="publication-entry__note">Associated with: {publication.associatedWith}</p>
  )}
  {publication.note && <p class="publication-entry__note">{publication.note}</p>}
  <ul class="link-list">
    {
      publication.links.map((link) => (
        <li>
          <a href={link.href} target="_blank" rel="noreferrer">
            {link.label}
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))
    }
  </ul>
</article>
