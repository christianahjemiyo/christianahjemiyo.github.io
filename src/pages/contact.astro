---
import SectionHeading from "@components/SectionHeading.astro";
import SocialLinks from "@components/SocialLinks.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { profile, publicLinks } from "@data/profile";

const contactLinks = publicLinks.filter((link) => link.includeInContact);
---

<BaseLayout
  title="Contact"
  description="Verified professional platforms for contacting Christianah O. Jemiyo."
>
  <section class="section">
    <SectionHeading eyebrow="Contact" title="Professional platforms" text={profile.invitation} />
    <SocialLinks links={contactLinks} />
  </section>
</BaseLayout>
