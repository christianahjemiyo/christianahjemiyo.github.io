---
import Callout from "@components/Callout.astro";
import PublicationEntry from "@components/PublicationEntry.astro";
import SectionHeading from "@components/SectionHeading.astro";
import Timeline from "@components/Timeline.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { education } from "@data/education";
import { experience } from "@data/experience";
import { profile } from "@data/profile";
import { publications } from "@data/publications";
import { memberships, service } from "@data/service";
import { skillGroups } from "@data/skills";

const selectedPublications = publications.filter((publication) => publication.featured).slice(0, 3);
---

<BaseLayout
  title="Résumé"
  description="Public-safe résumé overview for Christianah O. Jemiyo using approved professional information only."
>
  <section class="section">
    <SectionHeading
      eyebrow="Résumé"
      title="Public-safe professional overview"
      text="This page is not a copy of a private résumé and does not include private contact information."
    />
    <Callout title="Résumé availability">
      <p>{profile.resumeNote}</p>
      <p>
        A redacted public résumé can be added later at
        <code>public/documents/Christianah-Jemiyo-Resume.pdf</code> after explicit approval.
      </p>
    </Callout>
  </section>

  <section class="section section--compact" aria-labelledby="resume-summary">
    <div class="section-heading">
      <p class="eyebrow">Summary</p>
      <h1 id="resume-summary">Professional summary</h1>
    </div>
    <p class="hero__intro">{profile.biography}</p>
  </section>

  <section class="section section--compact" aria-labelledby="resume-skills">
    <div class="section-heading">
      <p class="eyebrow">Skills</p>
      <h1 id="resume-skills">Selected skills</h1>
    </div>
    <div class="card-grid">
      {
        skillGroups.map((group) => (
          <article class="skill-group">
            <h2>{group.title}</h2>
            <ul class="tag-list">
              {group.skills.map((skill) => <li>{skill}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--compact" aria-labelledby="resume-experience">
    <div class="section-heading">
      <p class="eyebrow">Experience</p>
      <h1 id="resume-experience">Experience</h1>
    </div>
    <Timeline entries={experience} />
  </section>

  <section class="section section--compact" aria-labelledby="resume-education">
    <div class="section-heading">
      <p class="eyebrow">Education</p>
      <h1 id="resume-education">Education</h1>
    </div>
    <div class="card-grid">
      {
        education.map((entry) => (
          <article class="info-card">
            <h2>{entry.degree}</h2>
            <p>{entry.institution}</p>
            {entry.completed && <p>Completed: {entry.completed}</p>}
            {entry.started && <p>Started: {entry.started}</p>}
            {entry.status && <p>Status: {entry.status}</p>}
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--compact" aria-labelledby="resume-publications">
    <div class="section-heading">
      <p class="eyebrow">Publications</p>
      <h1 id="resume-publications">Selected publications</h1>
    </div>
    <div class="text-stack">
      {selectedPublications.map((publication) => <PublicationEntry publication={publication} />)}
    </div>
  </section>

  <section class="section section--compact" aria-labelledby="resume-service">
    <div class="section-heading">
      <p class="eyebrow">Service</p>
      <h1 id="resume-service">Service and memberships</h1>
    </div>
    <Timeline entries={service} />
    <ul class="tag-list" style="margin-top: 1rem;">
      {memberships.map((membership) => <li>{membership}</li>)}
    </ul>
  </section>
</BaseLayout>
