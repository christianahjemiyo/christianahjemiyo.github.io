---
import type { Project } from "@data/types";

type Props = {
  project: Project;
};

const { project } = Astro.props;
---

<article class="project-card" data-project-card data-category={project.category}>
  <div class="project-card__top">
    <p class="badge">{project.category}</p>
    <p class="project-card__status">{project.status}</p>
  </div>
  <h2>{project.title}</h2>
  <p>{project.description}</p>
  <div class="project-card__section">
    <h3>Methods</h3>
    <ul class="tag-list">
      {project.methods.map((method) => <li>{method}</li>)}
    </ul>
  </div>
  <div class="project-card__section">
    <h3>Tools</h3>
    <ul class="tag-list tag-list--quiet">
      {project.technologies.map((technology) => <li>{technology}</li>)}
    </ul>
  </div>
  <p class="project-card__evidence">{project.evidence}</p>
  {project.privacyNote && <p class="project-card__privacy">{project.privacyNote}</p>}
  <div class="button-row">
    <a href={project.repository} class="button button--secondary" target="_blank" rel="noreferrer">
      Repository <span aria-hidden="true">↗</span>
    </a>
    {
      project.demo && (
        <a href={project.demo} class="button button--secondary" target="_blank" rel="noreferrer">
          Live app <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </div>
</article>
