---
import SectionHeading from "@components/SectionHeading.astro";
import Timeline from "@components/Timeline.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { experience } from "@data/experience";
---

<BaseLayout
  title="Experience"
  description="Approved professional and research experience for Christianah O. Jemiyo."
>
  <section class="section">
    <SectionHeading
      eyebrow="Experience"
      title="Research, analysis, and training roles"
      text="Roles are presented with approved dates, organizations, and concise descriptions."
    />
    <Timeline entries={experience} />
  </section>
</BaseLayout>
