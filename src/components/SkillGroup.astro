---
import type { SkillGroup } from "@data/types";

type Props = {
  group: SkillGroup;
};

const { group } = Astro.props;
---

<article class="skill-group">
  <h2>{group.title}</h2>
  {group.context && <p>{group.context}</p>}
  <ul class="tag-list">
    {group.skills.map((skill) => <li>{skill}</li>)}
  </ul>
</article>
